      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/setup.ps1"],
      "problemMatcher": []
    },
    {
      "label": "RiceStep: build",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/build.ps1"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "RiceStep: simulator",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/dev.ps1"],
      "problemMatcher": []
    },
    {
      "label": "RiceStep: list devices",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/devices.ps1"],
      "problemMatcher": []
    }
  ]
